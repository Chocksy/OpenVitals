DATABASE_URL=postgresql://postgres:postgres@localhost:5433/openvitals
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3001
OPENROUTER_API_KEY=
# Every non-OCR call. Provisional (41F-M): the daily model bake-off decides.
AI_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
AI_OCR_MODEL=google/gemini-2.5-flash
# Lab text into readings (extractFromText). Gemini by the owner's choice.
AI_EXTRACT_MODEL=google/gemini-3.7-flash
# Food photos (classifyPhoto). Gemini until the owner picks from pnpm eval:photos.
AI_PHOTO_MODEL=google/gemini-3.7-flash
# Optional. Without one the Semantic Scholar API answers 429 most of the time
# and the research run loses citation counts and venues. Free key from
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
UPLOAD_DIR=./data/uploads

# The model that answers questions in the ask box (pnpm eval:ask picks it).
# Falls back to AI_DEFAULT_MODEL when unset.
AI_ASK_MODEL=openai/gpt-6-luna

# Case research (phase 41C). Falls back to AI_DEFAULT_MODEL when unset.
# AI_CASE_REASONING (low | medium | high) turns the provider's reasoning on.
AI_CASE_MODEL=anthropic/claude-opus-5.5
AI_CASE_REASONING=
